PORT=3001
ADMIN_KEY=daogreen-admin-change-me
# key (default) | magic-link — temporary secret-link admin sessions
ADMIN_ACCESS_MODE=key
# Used only when ADMIN_ACCESS_MODE=magic-link (never put real secrets in git)
# Production values must be 64 hex characters or at least 43 base64url characters.
# Reusable temporary secret: rotate on suspected exposure, after visual work, and before returning to key-only access.
ADMIN_MAGIC_LINK_TOKEN=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_DAYS=7
DATABASE_PATH=./data/daogreen.db
CORS_ORIGIN=http://localhost:5173

# VPS за nginx (/spec/):
# VITE_BASE_PATH=/spec/
# VITE_PUBLIC_URL=http://YOUR_HOST/spec

# PostgreSQL (этап 2, см. backend/docs/DATABASE.md):
# DATABASE_DRIVER=postgres
# DATABASE_URL=postgresql://user:pass@localhost:5432/daogreen

# S3 / Object Storage (этап 2):
# STORAGE_DRIVER=s3
# S3_BUCKET=daogreen-uploads
# S3_REGION=ru-central1
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL=https://cdn.example.com

# Supabase backup (опционально):
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
